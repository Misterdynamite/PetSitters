<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit + component/integration tests for the PetSitters (Sitters4Us) logic layer.

    These test the UI-independent code directly: Services (AuthService,
    BookingService, ValidationHelper, PasswordHasher, and the launch-time
    database choice: AppConfig/EnvFile, DatabaseSelector), the domain Models,
    and the Data layer (repositories, MySqlUrl). This is the ENSE707
    "logic/unit-test" project and is separate from PetSitters.UiTests (the
    slower FlaUI end-to-end UI checks).

    Techniques applied from the ENSE707 labs:
      * MSTest, AAA structure, boundary + invalid-input tests        (Lab 1)
      * Result-object assertions, quality-attribute focus            (Lab 2)
      * Test names/categories linked to requirement IDs (traceability) (Lab 4)
      * Equivalence partitioning, boundary-value analysis, DataRow    (Lab 5)
      * Component/integration tests against real SQLite persistence,
        each using an isolated temporary database file                (Lab 5)

    The data layer runs on those SQLite temp files: no test touches the app's
    %AppData% database or the cloud database. MySQL parity tests
    (MySqlParityTests.cs, TestCategory=MySql) re-run the database tests on a
    temporary MySQL database, but only when opted in (PETSITTERS_TEST_MYSQL_URL
    or PETSITTERS_TEST_MYSQL=1); otherwise they are skipped, and the build gate
    and CI filter them out. See docs/UnitTests.md.

    Targets net472 to match the PetSitters app. Build the app first with VS
    MSBuild (the classic-style PetSitters app cannot be built by `dotnet`), then
    run these with `dotnet test PetSitters.Tests -c Debug`, or use Visual
    Studio's Test Explorer.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AssemblyName>PetSitters.Tests</AssemblyName>
    <RootNamespace>PetSitters.Tests</RootNamespace>
    <!-- MySqlConnector's dependencies (System.Memory etc.) need binding redirects on .NET Framework. -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.4" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.4" />
    <!--
      Pull in SQLite too so this project's build copies the native
      SQLite.Interop.dll (x86/x64) into the test output, letting the
      integration tests open a real database.
    -->
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.118" />
    <!--
      The app's MySQL driver: same version as PetSitters.csproj, so this
      project resolves (and binding-redirects) its dependencies consistently
      for the MySQL parity tests and anything else that loads the app's Data layer.
    -->
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Reference the BUILT PetSitters app assembly so tests can use its
      Models/Data/Services types. We reference the compiled output rather than
      the project because PetSitters is a classic (non-SDK) WPF project that the
      .NET SDK build cannot compile; build PetSitters first (Visual Studio, or
      VS MSBuild) and this picks up its output. In Visual Studio's Test Explorer
      this still works because the app is built as part of the solution.
    -->
    <Reference Include="PetSitters">
      <HintPath>..\bin\$(Configuration)\PetSitters.exe</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
