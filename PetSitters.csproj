  <!--
    Runtime settings (DATABASE_URL etc.). The repo-root .env is copied next to
    PetSitters.exe, where the app reads it at launch, but ONLY if it exists:
    it's git-ignored and holds a password, so CI and fresh clones build without
    it (and run on the local SQLite database). Hidden from Solution Explorer.
    Note: anything under bin\ then contains the password; don't share build folders.
  -->
  <ItemGroup Condition="Exists('.env')">
    <None Include=".env">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.118" />
    <!-- Cloud database driver (MIT). MySQL is tried first at launch; SQLite is the fallback. -->
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
  </ItemGroup>
