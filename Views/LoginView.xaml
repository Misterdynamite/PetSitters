<UserControl x:Class="PetSitters.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="500" d:DesignWidth="900"
             FontFamily="{StaticResource FredokaFont}">
    <!--
        To use Fredoka locally: add Fredoka-Regular.ttf and Fredoka-Bold.ttf
        to Assets/Fonts/ and set Build Action = Resource.
        The FontFamily below references the embedded font by family name.
    -->
    <Grid>
        <!-- Local design resources for this view -->
        <Grid.Resources>
            <SolidColorBrush x:Key="LoginPalettePale" Color="#FFF8E7BD"/>
            <SolidColorBrush x:Key="LoginPaletteDark" Color="#FFD99CA3"/>
            <SolidColorBrush x:Key="LoginPaletteMid" Color="#FFE9B3BB"/>
            <!-- fallback for white inputs -->
            <SolidColorBrush x:Key="LoginInputBg" Color="White"/>
            <!-- simple input style -->
            <Style x:Key="LoginInputStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource LoginInputBg}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Width" Value="320"/>
            </Style>
            <Style x:Key="LoginPasswordStyle" TargetType="PasswordBox">
                <Setter Property="Background" Value="{StaticResource LoginInputBg}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Width" Value="320"/>
            </Style>
        </Grid.Resources>

        <!-- Page background using pale color -->
        <Border Background="{StaticResource LoginPalettePale}"/>

        <!-- Top header bar -->
        <DockPanel LastChildFill="False"/>

        <!-- Centred login card, inside a ScrollViewer (DEF-005): when the window is
             too small for the card, the form scrolls instead of being cut off, so
             the password box and Log in button can always be reached. While the
             card fits, no scrollbar shows and it stays centred as before. -->
        <ScrollViewer x:Name="LoginScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Border Background="{StaticResource LoginPaletteMid}" CornerRadius="22" Padding="36"
                Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,40,16,16">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Welcome back" FontFamily="/PetSitters;component/Assets/Fonts/#Fredoka" FontSize="24" HorizontalAlignment="Center" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Log in to find or offer pet sitting." FontSize="15" HorizontalAlignment="Center" Foreground="White" Opacity="0.85" Margin="0,6,0,14"/>

                <!-- Shown only when the shared database couldn't be used at launch (local fallback).
                     The tooltip (set in code) gives the technical reason, for troubleshooting. -->
                <TextBlock x:Name="OfflineNotice" Visibility="Collapsed" TextWrapping="Wrap" Width="340"
                           Foreground="{StaticResource Warning}" FontWeight="SemiBold" Margin="0,0,0,8"
                           ToolTipService.ShowDuration="20000"
                           Text="Working offline. Only accounts on this computer will work, and your changes won't reach other users. Restart the app to reconnect."/>

                <TextBlock Text="Email" FontSize="16" FontFamily="/PetSitters;component/Assets/Fonts/#Fredoka" Foreground="White" HorizontalAlignment="Left" Margin="0,6,0,6"/>
                <TextBox x:Name="EmailBox" Style="{StaticResource LoginInputStyle}" HorizontalAlignment="Center"/>

                <TextBlock Text="Password" FontSize="16" FontFamily="/PetSitters;component/Assets/Fonts/#Fredoka" Foreground="White" HorizontalAlignment="Left" Margin="0,14,0,6"/>
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource LoginPasswordStyle}" HorizontalAlignment="Center"/>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap"
                           Margin="0,10,0,0" Visibility="Collapsed" HorizontalAlignment="Center"/>

                <!-- REQ-GR-06: only shown when the email + password match both an
                     owner and a sitter account, to pick which one to open. -->
                <StackPanel x:Name="RoleChoicePanel" Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,10,0,0" Visibility="Collapsed">
                    <RadioButton x:Name="LoginOwnerRadio" Content="Owner" GroupName="LoginRole"
                                 Foreground="White" Margin="0,0,16,0"/>
                    <RadioButton x:Name="LoginSitterRadio" Content="Sitter" GroupName="LoginRole"
                                 Foreground="White"/>
                </StackPanel>

                <Button x:Name="LoginButton" Content="Log in" Margin="0,20,0,0" Click="Login_Click" IsDefault="True" Width="180" Height="36"
                        HorizontalAlignment="Center" Background="{StaticResource LoginPaletteDark}" Foreground="{StaticResource LoginPalettePale}" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0" HorizontalAlignment="Center">
                    <TextBlock Text="New here? " Foreground="White" Opacity="0.9" VerticalAlignment="Center"/>
                    <Button Content="Create an account" Style="{StaticResource LinkButton}" Click="Register_Click" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
