<UserControl x:Class="PetSitters.Views.SitterDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="560" d:DesignWidth="900">
    <TabControl x:Name="RootTabs" Margin="16" Background="Transparent" BorderThickness="0">

        <!-- FR-7: personal details incl. location -->
        <TabItem Header="My Details">
            <Border Background="{StaticResource CardBg}" CornerRadius="8" Padding="24" Margin="0,12"
                    BorderBrush="#E5E7EB" BorderThickness="1" HorizontalAlignment="Left" Width="420"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="My details" Style="{StaticResource H1}"/>
                    <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="EmailText" FontSize="14"/>
                    <TextBlock Text="Full name" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NameBox"/>
                    <TextBlock Text="Phone" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PhoneBox"/>
                    <TextBlock Text="Location (suburb / city)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="LocationBox"/>
                    <Button Content="Save details" Margin="0,16,0,0" HorizontalAlignment="Left"
                            Click="SaveDetails_Click"/>
                    <TextBlock x:Name="DetailsStatus" Foreground="{StaticResource Brand}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </TabItem>

        <!-- FR-8: availability, experience, preferences, qualifications, daily rate -->
        <TabItem Header="My Sitting Profile">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Background="{StaticResource CardBg}" CornerRadius="8" Padding="24" Margin="0,12"
                        BorderBrush="#E5E7EB" BorderThickness="1" HorizontalAlignment="Left" Width="520"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="My sitting profile" Style="{StaticResource H1}"/>
                        <TextBlock Text="This is what pet owners see when they browse sitters."
                                   Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>

                        <TextBlock Text="Short introduction" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="BioBox" AcceptsReturn="True" TextWrapping="Wrap" Height="60"/>

                        <TextBlock Text="Availability (e.g. Weekends and weekday evenings)"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="AvailabilityBox" AcceptsReturn="True" TextWrapping="Wrap" Height="48"/>

                        <TextBlock Text="Years of experience" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ExperienceBox" Text="0" Width="80" HorizontalAlignment="Left"/>

                        <TextBlock Text="Preferences (e.g. Works great with cats)"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="PreferencesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="48"/>

                        <TextBlock Text="Qualifications / other information" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="QualificationsBox" AcceptsReturn="True" TextWrapping="Wrap" Height="48"/>

                        <TextBlock Text="Daily rate ($ per day)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="RateBox" Text="0" Width="120" HorizontalAlignment="Left"/>

                        <Button Content="Save profile" Margin="0,18,0,0" HorizontalAlignment="Left"
                                Click="SaveProfile_Click"/>
                        <TextBlock x:Name="ProfileStatus" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </TabItem>

        <!-- Incoming booking requests (the sitter side of FR-6) -->
        <TabItem Header="Booking Requests">
            <Grid Margin="0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource CardBg}" CornerRadius="8" Padding="16"
                        BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,12,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Requests from owners" Style="{StaticResource H1}"/>
                        <ListView x:Name="RequestsList" BorderThickness="0"
                                  SelectionChanged="RequestsList_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="From" DisplayMemberBinding="{Binding OwnerName}" Width="130"/>
                                    <GridViewColumn Header="Dates" DisplayMemberBinding="{Binding DateRange}" Width="170"/>
                                    <GridViewColumn Header="Nights" DisplayMemberBinding="{Binding Nights}" Width="55"/>
                                    <GridViewColumn Header="Est. total" DisplayMemberBinding="{Binding Total}" Width="80"/>
                                    <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="80"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource CardBg}" CornerRadius="8" Padding="16"
                        BorderBrush="#E5E7EB" BorderThickness="1" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Selected request" Style="{StaticResource H2}"/>
                        <TextBlock Text="Message" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="RequestMessage" TextWrapping="Wrap"
                                   Text="Select a request to view its message."/>
                        <Button Content="View details" Style="{StaticResource SecondaryButton}"
                                Margin="0,12,0,0" Click="ViewDetails_Click"/>
                        <Button Content="Accept" Margin="0,14,0,0" Click="Accept_Click"/>
                        <Button Content="Decline" Style="{StaticResource DangerButton}" Margin="0,8,0,0"
                                Click="Decline_Click"/>
                        <TextBlock x:Name="RequestStatus" Foreground="{StaticResource Brand}" Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>

        <!-- My Chats: list accepted bookings with an Open Chat action -->
        <TabItem Header="My Chats">
            <Grid Margin="0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource CardBg}" CornerRadius="8" Padding="16"
                        BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,12,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Active chats (accepted bookings)" Style="{StaticResource H1}"/>
                        <ListView x:Name="ChatsList" BorderThickness="0" SelectionChanged="ChatsList_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="With" DisplayMemberBinding="{Binding OwnerName}" Width="150"/>
                                    <GridViewColumn Header="Dates" DisplayMemberBinding="{Binding DateRange}" Width="170"/>
                                    <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="80"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource CardBg}" CornerRadius="8" Padding="16"
                        BorderBrush="#E5E7EB" BorderThickness="1" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Selected chat" Style="{StaticResource H2}"/>
                        <TextBlock Text="Details" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="ChatSelectedDetails" TextWrapping="Wrap" Text="Select a chat to open."/>
                        <Button Content="Open chat" Margin="0,12,0,0" Click="OpenChat_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>

        <!-- Chat tab becomes visible once a booking is accepted and is scoped to that booking -->
        <TabItem Header="Chat" x:Name="ChatTab" Visibility="Collapsed">
            <Grid Margin="0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="{StaticResource CardBg}" CornerRadius="8" Padding="16"
                        BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,12,0">
                    <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ChatMessagesList">
                            <!-- Items bound programmatically -->
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBox x:Name="ChatInput" Width="680" Height="36"/>
                    <Button Content="Send" Margin="8,0,0,0" Width="80" Click="ChatSend_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
