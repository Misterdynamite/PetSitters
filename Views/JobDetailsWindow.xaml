<Window x:Class="PetSitters.Views.JobDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Booking request details"
        Height="620" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource PageBg}">
    <Border Background="{StaticResource CardBg}" CornerRadius="8" Margin="16" Padding="22"
            BorderBrush="#E5E7EB" BorderThickness="1">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Booking request" Style="{StaticResource H1}"/>
                <TextBlock x:Name="SubtitleText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            </StackPanel>

            <Button DockPanel.Dock="Bottom" Content="Close" HorizontalAlignment="Right"
                    Margin="0,16,0,0" Click="Close_Click" IsCancel="True" IsDefault="True"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                <StackPanel>
                    <!-- Pet -->
                    <TextBlock Text="Pet" Style="{StaticResource H2}"/>
                    <TextBlock x:Name="PetSummaryText" TextWrapping="Wrap"/>
                    <StackPanel x:Name="PetDetailPanel">
                        <TextBlock Text="Species" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="PetSpeciesText"/>
                        <TextBlock Text="Breed" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="PetBreedText"/>
                        <TextBlock Text="Age" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="PetAgeText"/>
                        <TextBlock Text="Care notes" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="PetNotesText" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Booking -->
                    <TextBlock Text="Booking" Style="{StaticResource H2}"/>
                    <TextBlock Text="Dates" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="DatesText"/>
                    <TextBlock Text="Nights" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="NightsText"/>
                    <TextBlock Text="Estimated total" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="TotalText"/>
                    <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="StatusText"/>

                    <!-- Owner -->
                    <TextBlock Text="Owner" Style="{StaticResource H2}"/>
                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="OwnerNameText"/>
                    <TextBlock Text="Location" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="OwnerLocationText"/>
                    <TextBlock Text="Phone" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="OwnerPhoneText"/>

                    <!-- Message -->
                    <TextBlock Text="Message" Style="{StaticResource H2}"/>
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
