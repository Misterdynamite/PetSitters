<Project Sdk="Microsoft.NET.Sdk">

  <!--
    End-to-end UI REGRESSION tests for the PetSitters (Sitters4Us) WPF app.

    These drive the *real* built PetSitters.exe through the Windows UI Automation
    layer (via FlaUI) - clicking buttons, typing into boxes and reading labels
    exactly as a human would. They are the outermost layer of the test pyramid and
    are deliberately separate from PetSitters.Tests (the fast logic/unit +
    persistence tests).

    Their regression job is to catch breakages that unit tests cannot see: view
    wiring, navigation between screens, and cross-role workflows. Notably FR-S3
    (sitter views full job details before deciding) is UI-only presentation, so
    this project is its ONLY automated coverage.

    Targets net472 to match the PetSitters app.

    IMPORTANT - build order: like PetSitters.Tests, this project does NOT use a
    <ProjectReference> to PetSitters.csproj, because the .NET SDK cannot build
    that classic (non-SDK) WPF project. Build the app first with Visual Studio /
    VS MSBuild, then build+run these tests. The app is launched as a process
    (located at runtime by AppLocator), so no assembly reference is needed at all.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AssemblyName>PetSitters.UiTests</AssemblyName>
    <RootNamespace>PetSitters.UiTests</RootNamespace>
    <!-- UI automation cannot run in parallel with itself. -->
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.4" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.4" />
    <PackageReference Include="FlaUI.Core" Version="4.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
  </ItemGroup>

</Project>
