<Window x:Class="PetSitters.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PetSitters"
        mc:Ignorable="d"
        Title="Sitters4Us" Height="640" Width="920"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBg}">
    <DockPanel>
        <!-- Top header (unified with LoginView header) -->
        <Border DockPanel.Dock="Top" Background="{StaticResource LoginPaletteDark}" Height="72">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="🐾" FontSize="28" VerticalAlignment="Center" Foreground="{StaticResource LoginPalettePale}"/>
                    <TextBlock Text="Sitters4Us" FontSize="36" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource LoginPalettePale}"/>
                </StackPanel>
                <StackPanel x:Name="SessionBar" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,20,0">
                    <TextBlock x:Name="SessionText" Foreground="{StaticResource LoginPalettePale}" VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <Button x:Name="LogoutButton" Content="Log out" Style="{StaticResource SecondaryButton}"
                            Click="LogoutButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Active view is swapped in here -->
        <ContentControl x:Name="RootContent"/>
    </DockPanel>
</Window>
