<Window x:Class="PetSitters.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PetSitters"
        mc:Ignorable="d"
        Title="Sitters4Us" Height="640" Width="920"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBg}">
    <DockPanel>
        <!-- Top app bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brand}" Padding="16,10">
            <Grid>
                <TextBlock Text="🐾 Sitters4Us" Foreground="White" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <StackPanel x:Name="SessionBar" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="SessionText" Foreground="White" VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <Button x:Name="LogoutButton" Content="Log out" Style="{StaticResource SecondaryButton}"
                            Click="LogoutButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Active view is swapped in here -->
        <ContentControl x:Name="RootContent"/>
    </DockPanel>
</Window>
